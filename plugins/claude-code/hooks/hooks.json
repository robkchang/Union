{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/launch.py\" --data \"${CLAUDE_PLUGIN_DATA}\" bootstrap",
            "timeout": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/launch.py\" --data \"${CLAUDE_PLUGIN_DATA}\" status busy",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/launch.py\" --data \"${CLAUDE_PLUGIN_DATA}\" status idle",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
